# Photo Tools — environment template
# Copy to `.env` and adjust for your machine.

PORT=4000

# Paths to the CLI-enabled processing engines (REQUIRED). Build them first —
# see bin-src/ and docs/windows-deployment.md.
PHOTO_RESIZER_EXE=C:\absolute\path\to\PhotoResizer.exe
PHOTO_CONVERTER_EXE=C:\absolute\path\to\PhotoConverter.exe
PHOTO_ENHANCER_EXE=C:\absolute\path\to\PhotoEnhancer.exe
PHOTO_SCANNER_EXE=C:\absolute\path\to\PhotoScanner.exe
PHOTO_PDF_EXE=C:\absolute\path\to\PhotoPdf.exe
PHOTO_REMOVEBG_EXE=C:\absolute\path\to\PhotoRemoveBg.exe
PHOTO_COMPRESS_EXE=C:\absolute\path\to\PhotoCompress.exe
PHOTO_WATERMARK_EXE=C:\absolute\path\to\PhotoWatermark.exe

# FFmpeg is only needed for video compression. It is installed on the host, not
# bundled with the app. Leave these unset to auto-detect ffmpeg/ffprobe on PATH
# (FFMPEG_PATH / FFPROBE_PATH are also accepted as aliases).
# PHOTO_FFMPEG_EXE=C:\ffmpeg\bin\ffmpeg.exe
# PHOTO_FFPROBE_EXE=C:\ffmpeg\bin\ffprobe.exe
# Python is only needed for OCR and media extraction helpers in bin-src/.
# Leave unset to auto-detect python on PATH (PYTHON_PATH is an alias).
# PYTHON_EXE=C:\Python313\python.exe

# Temporary working directory for uploaded files and job output.
TEMP_DIRECTORY=C:\absolute\path\to\photo-tools\temp
# Where the job queue and auth database are stored (defaults: temp/).
# JOB_DB_PATH=C:\absolute\path\to\photo-tools\temp\job-store.sqlite
# AUTH_DB_PATH=C:\absolute\path\to\photo-tools\temp\auth-store.sqlite

# Limits and timeouts.
MAX_FILE_SIZE_MB=50
# Videos are larger than images and get their own (larger) upload cap.
MAX_VIDEO_FILE_SIZE_MB=500
PROCESS_TIMEOUT_SECONDS=120
# Multi-page scans may need more time than a single image.
SCAN_PROCESS_TIMEOUT_SECONDS=600
# Video re-encoding (and target-size iterations) is slow; allow a long budget.
VIDEO_PROCESS_TIMEOUT_SECONDS=1800
MAX_CONCURRENT_JOBS=4
# How long finished jobs (records + output files) stay downloadable. Keep this
# comfortably longer than the longest session; the My Files page reads these.
JOB_RETENTION_MINUTES=1440
CLEANUP_INTERVAL_MINUTES=5

# Security.
# Comma-separated list of allowed browser origins (the frontend).
FRONTEND_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
# Uncomment to require an API key (comma-separated). Strongly recommended when
# the backend is exposed beyond localhost. The frontend reads it via API_KEY
# (see frontend/.env.example) and injects it server-side through the BFF proxy.
# API_KEYS=change-me

# Hardened response headers (CSP, HSTS, nosniff, frame-deny, ...). Set to
# false only when a reverse proxy already injects them.
SECURITY_HEADERS=true
# Content-Security-Policy applied to API responses.
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
HSTS_MAX_AGE_SECONDS=15552000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# Reject plaintext HTTP (set when running behind a TLS-terminating proxy).
REQUIRE_HTTPS=false
# Honour X-Forwarded-* headers. Defaults to on in production, off otherwise.
# TRUST_PROXY=true
# Query parser: "simple" (default, safer) or "extended".
# QUERY_PARSER=simple
# Maximum JSON request body and URL length.
JSON_BODY_LIMIT=1mb
MAX_URL_LENGTH=2048
# Reject cross-origin state-changing requests that carry a session cookie.
CSRF_PROTECTION=true
# Emit one audit log line per request.
REQUEST_LOGGING=true
# Abort startup when the security audit finds an error (default: on in prod).
# SECURITY_STRICT=true

# User accounts (login / signup). When enabled, resize/convert/job endpoints
# require a signed-in user. Set AUTH_ENABLED=false to run without accounts.
AUTH_ENABLED=true
# Auth storage: "sqlite" (default, temp/auth-store.sqlite) or "memory".
AUTH_STORE=sqlite
# Session cookie/header names. Change only if they collide with another app on
# the same domain. Native clients send the access token in the header.
# SESSION_COOKIE_NAME=pictools_session
# ACCESS_COOKIE_NAME=pictools_access
# REFRESH_COOKIE_NAME=pictools_refresh
# SESSION_HEADER_NAME=x-session-token
# ACCESS_TOKEN_HEADER_NAME=x-access-token
# Legacy opaque sessions (pre-JWT); valid until they expire.
SESSION_TTL_DAYS=7
# JWT signing secret for access + refresh tokens. Recommended outside
# localhost; if unset in production a random one is generated per boot, which
# signs everyone out on restart. Use a long random string.
# JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (minutes) and refresh token lifetime (days). The web
# client silently refreshes before the access token expires.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Login/register throttling: attempts per window, keyed per IP+email (x1) and
# per IP (x10). Exceeding either returns HTTP 429 with a Retry-After header.
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# Default demo account, created automatically on first startup.
DEFAULT_USER_EMAIL=demo@pic.tools
DEFAULT_USER_PASSWORD=password123
# Grant the seeded default account administrator rights (default: true).
DEFAULT_USER_IS_ADMIN=true
# Password policy enforced when users register.
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_COMPLEXITY=true
PASSWORD_BLOCKLIST=true
# A valid-but-replayed refresh token revokes every session for that user.
AUTH_REFRESH_REUSE_REVOKE=true

# --- Account recovery -------------------------------------------------------
# Password-reset links point at the public web app; the code paths (SMS/WhatsApp)
# expire sooner than the emailed link. Leave defaults for local development.
# PUBLIC_APP_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
RECOVERY_CODE_TTL_MINUTES=10

# --- Outbound email (contact form + password-reset / login-email messages) ---
# Optional. When SMTP_HOST is unset, messages are logged instead of sent so the
# stack still runs with no mail setup. Works with any SMTP provider (Gmail app
# password, Postmark, SendGrid, Mailgun, ...).
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to true for implicit TLS (port 465). Leave false for STARTTLS (port 587).
SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# From address on outgoing mail (defaults to SMTP_USER).
# CONTACT_FROM_EMAIL=no-reply@example.com
# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=mujiburrahman.dev@gmail.com

# --- SMS & WhatsApp recovery codes (Twilio) ---------------------------------
# Optional. Credits are only required for the SMS/WhatsApp reset options; email
# recovery works without Twilio. When unset those channels log instead of send.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# An SMS-capable Twilio number, in E.164 (e.g. +15551234567).
# SMS_FROM_NUMBER=+15551234567
# A WhatsApp-enabled Twilio sender (number or "whatsapp:+..."). The messaging
# channel handles the "whatsapp:" prefix automatically.
# WHATSAPP_FROM_NUMBER=+15551234567

# --- Paid plan subscriptions (Stripe) -----------------------------------------
# Optional. When all three values are set, the profile page shows "Subscribe"
# buttons: checkout runs in Stripe's hosted page on RECURRING prices, the plan
# activates when the server re-fetches the completed session (works even with
# no public URL). Renewals, cancellations and failed payments arrive through
# STRIPE_WEBHOOK_SECRET — point a Stripe webhook at POST /api/billing/webhook;
# without it the server still reconciles on each /api/credits access (throttled)
# and on a periodic sweep, just less promptly. Until configured, the endpoints
# return 503 and the buttons stay hidden. Monthly credits renew on the rolling
# 30-day cycle regardless of the billing cycle.
# STRIPE_SECRET_KEY=your_stripe_test_secret_key_here
# Recurring prices (Price ID of a RECURRING price, not a one-time Price).
# STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxx
# STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxx
# Annual prices (also RECURRING, billed yearly). When both annual IDs are set
# the pricing page and the checkout page offer a monthly/annual switch and
# annual billing is advertised as 30% cheaper. When they are missing, only
# monthly billing is offered.
# STRIPE_PRICE_PRO_ANNUAL=price_xxxxxxxxxxxxxxxx
# STRIPE_PRICE_BUSINESS_ANNUAL=price_xxxxxxxxxxxxxxxx
# Signing secret of the webhook endpoint (whsec_...), optional but recommended.
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Google sign-in ---------------------------------------------------------
# Optional. When set, the web app shows "Continue with Google" and posts the
# returned ID token to /api/auth/google. Use the same OAuth Web client ID here
# and as NEXT_PUBLIC_GOOGLE_CLIENT_ID in frontend/.env.local. The backend verifies
# the token's signature (RS256/JWKS), issuer, audience and expiry.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# For the mobile app, list every OAuth client ID whose tokens this backend should
# accept (web + Android + iOS are separate audiences). Overrides GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_IDS=xxxxxxxxxxxx.apps.googleusercontent.com,yyyyyyyyyyyy.apps.googleusercontent.com

# --- URL downloader (direct media files + HLS manifests) --------------------
# SSRF-hardened: private/loopback targets are refused unless explicitly allowed.
URL_DOWNLOAD_ENABLED=true
URL_DOWNLOAD_MAX_MB=500
URL_DOWNLOAD_TIMEOUT_SECONDS=600
URL_DOWNLOAD_MAX_REDIRECTS=5
URL_DOWNLOAD_MAX_PLAYLIST_KB=2048
URL_DOWNLOAD_MAX_SEGMENTS=5000
# Allow loopback/private-network targets. Leave false in production (SSRF risk).
URL_DOWNLOAD_ALLOW_PRIVATE=false

# Optional production infrastructure. Leave unset to use the zero-setup local
# fallbacks: in-process job queue + SQLite job store (temp/job-store.sqlite).
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgres://postgres:password@localhost:5432/photo_tools

LOG_LEVEL=info
