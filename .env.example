# Photo Tools — environment template
# Copy to `.env` and adjust for your machine.

PORT=4000

# Paths to the CLI-enabled processing engines (REQUIRED). Build them first —
# see bin-src/ and docs/windows-deployment.md.
PHOTO_RESIZER_EXE=C:\absolute\path\to\PhotoResizer.exe
PHOTO_CONVERTER_EXE=C:\absolute\path\to\PhotoConverter.exe
PHOTO_ENHANCER_EXE=C:\absolute\path\to\PhotoEnhancer.exe
PHOTO_SCANNER_EXE=C:\absolute\path\to\PhotoScanner.exe
PHOTO_PDF_EXE=C:\absolute\path\to\PhotoPdf.exe
PHOTO_REMOVEBG_EXE=C:\absolute\path\to\PhotoRemoveBg.exe
PHOTO_COMPRESS_EXE=C:\absolute\path\to\PhotoCompress.exe
PHOTO_WATERMARK_EXE=C:\absolute\path\to\PhotoWatermark.exe

# FFmpeg is only needed for video compression. It is installed on the host, not
# bundled with the app. Leave these unset to auto-detect ffmpeg/ffprobe on PATH.
# PHOTO_FFMPEG_EXE=C:\ffmpeg\bin\ffmpeg.exe
# PHOTO_FFPROBE_EXE=C:\ffmpeg\bin\ffprobe.exe

# Temporary working directory for uploaded files and job output.
TEMP_DIRECTORY=C:\absolute\path\to\photo-tools\temp

# Limits and timeouts.
MAX_FILE_SIZE_MB=50
# Videos are larger than images and get their own (larger) upload cap.
MAX_VIDEO_FILE_SIZE_MB=500
PROCESS_TIMEOUT_SECONDS=120
# Multi-page scans may need more time than a single image.
SCAN_PROCESS_TIMEOUT_SECONDS=600
# Video re-encoding (and target-size iterations) is slow; allow a long budget.
VIDEO_PROCESS_TIMEOUT_SECONDS=1800
MAX_CONCURRENT_JOBS=4
JOB_RETENTION_MINUTES=15
CLEANUP_INTERVAL_MINUTES=5

# Security.
# Comma-separated list of allowed browser origins (the frontend).
FRONTEND_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
# Uncomment to require an API key (comma-separated). Strongly recommended when
# the backend is exposed beyond localhost. The frontend reads it via API_KEY
# (see frontend/.env.example) and injects it server-side through the BFF proxy.
# API_KEYS=change-me

# User accounts (login / signup). When enabled, resize/convert/job endpoints
# require a signed-in session. Set AUTH_ENABLED=false to run without accounts.
AUTH_ENABLED=true
# Auth storage: "sqlite" (default, temp/auth-store.sqlite) or "memory".
AUTH_STORE=sqlite
SESSION_TTL_DAYS=7
# Default demo account, created automatically on first startup.
DEFAULT_USER_EMAIL=demo@pic.tools
DEFAULT_USER_PASSWORD=password123

# Optional production infrastructure. Leave unset to use the zero-setup local
# fallbacks: in-process job queue + SQLite job store (temp/job-store.sqlite).
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgres://postgres:password@localhost:5432/photo_tools

LOG_LEVEL=info
