# Backend configuration
# Copy to frontend/.env.local
BACKEND_URL=http://localhost:4000

# Only needed if the backend requires an API key (API_KEYS set in the backend
# .env). Kept server-side; never exposed to the browser.
API_KEY=

# Optional. Enables the "Continue with Google" button on the login/signup pages.
# Use the same OAuth Web client ID as GOOGLE_CLIENT_ID in the backend .env.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

