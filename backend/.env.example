# Server configuration
PORT=4000
NODE_ENV=development
DATA_DIR=./data

# Security & CORS
SESSION_SECRET=development-session-secret-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000

# Google Social Sign-In API
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized JavaScript origin: http://localhost:3000
GOOGLE_CLIENT_ID=
# Optional comma-separated list of additional client IDs (e.g. Android, iOS apps)
GOOGLE_CLIENT_IDS=

# Default Demo Account (Seeded on first startup if no users exist)
DEFAULT_USER_EMAIL=demo@pic.tools
DEFAULT_USER_PASSWORD=password123
DEFAULT_USER_IS_ADMIN=true

# Stripe Billing (Optional)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_SECRET=

# Email SMTP (Optional - defaults to console log when omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PicTools <noreply@pic.tools>"
