{
  "name": "photo-tools-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Photo Tools — executes PhotoResizer.exe and PhotoConverter.exe as processing engines.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "multer": "^2.2.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
